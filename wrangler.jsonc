{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "setlist-connector",
  "main": "src/worker.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // The connector is STATELESS — the only Durable Object is the harness's
  // per-session MCP agent (`SetlistMcpAgent`). setlist.fm's read surface needs
  // no cache, so there is no cache Durable Object here (unlike ofw-connector).
  "durable_objects": {
    "bindings": [{ "name": "MCP_OBJECT", "class_name": "SetlistMcpAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SetlistMcpAgent"] }],
  // setlist-connector's own OAuth token store. Kept separate from any other
  // connector's OAUTH_KV so their OAuth grants/tokens never cross-wire. To stand
  // up a deployment, create your own (wrangler kv namespace create OAUTH_KV) and
  // replace this placeholder id (see docs/DEPLOY-CONNECTOR.md).
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "REPLACE_WITH_OAUTH_KV_NAMESPACE_ID" }],
  // Production custom domain (matches ofw-connector's connector.ofw.nullnet.app
  // and untappd-mcp's connector.untappd.nullnet.app). The zone must be in the
  // deploying account's Cloudflare; wrangler provisions the hostname on deploy.
  // Remove this route to deploy to *.workers.dev only.
  "routes": [{ "pattern": "connector.setlist.nullnet.app", "custom_domain": true }],
  "workers_dev": true,
  "observability": {
    "enabled": true
  }
}
